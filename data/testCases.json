[
  {
    "name": "GET pet by id returns expected payload",
    "method": "GET",
    "path": "/pet/1",
    "expectedStatus": 200,
    "expectedHeaders": {
      "content-type": "application/json"
    },
    "expectedResponse": {
      "id": 1,
      "name": "Pet1"
    },
    "schema": "data/schemas/pet.schema.json"
  },
  {
    "name": "POST pet surfaces live service error for valid payload",
    "method": "POST",
    "path": "/pet",
    "payload": {
      "id": 101,
      "category": {
        "id": 1,
        "name": "dogs"
      },
      "name": "Fluffy",
      "photoUrls": [
        "https://example.com/fluffy.png"
      ],
      "tags": [
        {
          "id": 1,
          "name": "friendly"
        }
      ],
      "status": "available"
    },
    "expectedStatus": 500,
    "expectedHeaders": {
      "content-type": "application/json"
    }
  }
]
