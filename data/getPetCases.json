[
  {
    "name": "GET pet by id 1",
    "path": "/pet/1",
    "expectedStatus": 200,
    "expectedHeaders": {
      "content-type": "application/json"
    },
    "expectedResponse": {
      "id": 1,
      "name": "Pet1"
    },
    "schema": "data/schemas/pet.schema.json"
  },
  {
    "name": "GET missing pet id is handled by API",
    "path": "/pet/9999999",
    "expectedStatus": [404, 500],
    "expectedHeaders": {
      "content-type": "application/json"
    }
  }
]
